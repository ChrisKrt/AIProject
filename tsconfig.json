{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "paths": {
            "@app/*": [
                "./src/Application/*"
            ],
            "@infra/*": [
                "./src/Infrastructure/*"
            ],
            "@ui/*": [
                "./src/Presentation/*"
            ]
        }
    },
    "include": [
        "src",
        "svelte.config.js"
    ]
}