{# RELEASE.md — contains only Features and Bug Fixes (no Miscellaneous / chores) #}
{# This file is overwritten on each release and used as the GitHub release body. #}
{% for release in tree %}
# Release {{ release.version }} ({{ release.date if release.date else "Unreleased" }})
{% set has_content = namespace(value=false) %}
{% for change_type, changes in release.changes.items() %}{% if change_type != "Miscellaneous" %}{% set has_content.value = true %}{% endif %}{% endfor %}
{% if not has_content.value %}
_No user-facing changes in this release._
{% else %}
{% for change_type, changes in release.changes.items() %}
{% if change_type != "Miscellaneous" %}
## {{ change_type }}
{% for change in changes %}
- {% if change.scope %}**(#{{ change.scope }})** {% endif %}{{ change.message }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
